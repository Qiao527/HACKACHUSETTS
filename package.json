{
  "name": "solaralign",
  "version": "1.0.0",
  "private": true,
  "description": "SolarAlign — collect evidence, compare roof and solar timing, and align project value so more viable rooftop solar can move forward.",
  "scripts": {
    "dev": "concurrently -k -n next,api -c cyan,magenta \"next dev\" \"npm run dev:api\"",
    "dev:next": "next dev",
    "dev:api": "python -m uvicorn api.index:app --reload --port 8000",
    "build": "next build",
    "generate:worksheet": "python scripts/generate_field_worksheet.py",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-test-renderer": "18.3.0",
    "autoprefixer": "10.4.19",
    "concurrently": "8.2.2",
    "postcss": "8.4.39",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "vitest": "2.0.3"
  }
}
